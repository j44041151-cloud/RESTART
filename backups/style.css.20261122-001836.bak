:root {
  --amber: #ffb347;
  --amber-hot: #ffd08a;
  --cyan: #5ff2e0;
  --ink: #070a0c;
  --panel: rgba(9, 14, 17, 0.72);
  --panel-line: rgba(255, 179, 71, 0.28);
  --text: #eaf1f2;
  --dim: #8fa0a4;
  --font: "Segoe UI", "Inter", system-ui, -apple-system, sans-serif;
  --mono: "Consolas", "SFMono-Regular", ui-monospace, monospace;
}

* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { width: 100%; height: 100%; overflow: hidden; background: #05080a; color: var(--text); font-family: var(--font); }
body { user-select: none; -webkit-user-select: none; }
canvas#game-canvas { position: fixed; inset: 0; width: 100%; height: 100%; display: block; outline: none; }
.hidden { display: none !important; }

#vignette {
  position: fixed; inset: 0; pointer-events: none; z-index: 5;
  background:
    radial-gradient(ellipse at 50% 45%, transparent 45%, rgba(0,0,0,0.38) 100%),
    linear-gradient(to bottom, rgba(0,0,0,0.18), transparent 18%, transparent 82%, rgba(0,0,0,0.3));
  mix-blend-mode: multiply;
}

#letterbox { position: fixed; inset: 0; pointer-events: none; z-index: 40; }
#letterbox .lb-top, #letterbox .lb-bottom { position: absolute; left: 0; right: 0; height: 0; background: #000; transition: height .6s cubic-bezier(.2,.7,.2,1); }
#letterbox .lb-top { top: 0; } #letterbox .lb-bottom { bottom: 0; }
#letterbox.active .lb-top, #letterbox.active .lb-bottom { height: 11vh; }

#fade { position: fixed; inset: 0; background: #000; opacity: 0; pointer-events: none; z-index: 60; transition: opacity .45s ease; }
#fade.on { opacity: 1; }
#fade.white { background: #fff; }

/* ================= HUD ================= */
#hud { position: fixed; inset: 0; z-index: 10; pointer-events: none; }

#mission-panel {
  position: absolute; top: 26px; left: 28px; min-width: 290px; max-width: 360px;
  padding: 16px 20px 16px 18px;
  background: linear-gradient(120deg, rgba(6,10,12,.82), rgba(6,10,12,.42) 70%, transparent);
  border-left: 2px solid var(--amber);
  backdrop-filter: blur(7px);
  clip-path: polygon(0 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%);
  animation: hudIn .5s ease both;
}
.mission-kicker { font-family: var(--mono); font-size: 10px; letter-spacing: 3px; color: var(--amber); opacity: .9; }
#mission-title { font-size: 21px; font-weight: 600; letter-spacing: .5px; margin: 3px 0 10px; text-shadow: 0 2px 12px rgba(0,0,0,.6); }
#objective-list { list-style: none; display: flex; flex-direction: column; gap: 7px; }
#objective-list li { font-size: 13px; color: #cdd8da; display: flex; align-items: flex-start; gap: 9px; line-height: 1.35; transition: color .3s, opacity .3s; }
#objective-list li::before {
  content: ""; flex: 0 0 auto; width: 9px; height: 9px; margin-top: 4px; border: 1px solid rgba(255,179,71,.65);
  transform: rotate(45deg); transition: all .3s;
}
#objective-list li.done { color: #6d7c7f; text-decoration: line-through; opacity: .62; }
#objective-list li.done::before { background: var(--amber); box-shadow: 0 0 10px rgba(255,179,71,.6); }
#objective-list li.active { color: #fff; }
#objective-list li.active::before { background: rgba(255,179,71,.35); box-shadow: 0 0 12px rgba(255,179,71,.5); animation: pulseSq 1.8s infinite; }
@keyframes pulseSq { 50% { background: var(--amber); } }

#stats-panel { position: absolute; top: 26px; right: 28px; display: flex; flex-direction: column; gap: 8px; align-items: flex-end; }
.stat {
  display: flex; align-items: center; gap: 8px; padding: 8px 14px; min-width: 120px; justify-content: flex-end;
  background: var(--panel); border: 1px solid rgba(255,255,255,.07); border-right: 2px solid var(--amber);
  font-family: var(--mono); font-size: 16px; letter-spacing: 1px;
}
.stat-icon { font-size: 15px; }
.stat-icon.energy { color: var(--amber); text-shadow: 0 0 12px var(--amber); }
.stat-icon.spark { color: var(--cyan); text-shadow: 0 0 12px var(--cyan); }
.stat-sub { font-size: 9px; color: var(--dim); letter-spacing: 1.5px; }

#compass { position: absolute; top: 26px; left: 50%; transform: translateX(-50%); text-align: center; }
.compass-ring { position: relative; width: 190px; height: 24px; border-bottom: 1px solid rgba(255,255,255,.18); display: flex; justify-content: space-between; align-items: flex-start; font-family: var(--mono); font-size: 10px; color: rgba(255,255,255,.45); letter-spacing: 2px; }
.compass-ring .tick { position: absolute; top: 0; }
.compass-ring .n { left: 50%; transform: translateX(-50%); color: var(--amber); }
.compass-ring .e { right: 0; } .compass-ring .s { left: 50%; transform: translateX(-50%); top: 7px; font-size: 8px; opacity: .5; } .compass-ring .w { left: 0; }
#compass-needle { position: absolute; top: 15px; left: 50%; width: 7px; height: 7px; margin-left: -3.5px; background: var(--amber); transform: rotate(45deg); box-shadow: 0 0 10px var(--amber); transition: transform .2s; }
#compass-distance { font-family: var(--mono); font-size: 9px; letter-spacing: 2px; color: var(--dim); margin-top: 6px; }

#reticle { position: absolute; top: 50%; left: 50%; width: 4px; height: 4px; margin: -2px 0 0 -2px; border-radius: 50%; background: rgba(255,255,255,.55); box-shadow: 0 0 6px rgba(0,0,0,.8); opacity: .5; }

#interaction-prompt {
  position: absolute; left: 50%; bottom: 15%; transform: translateX(-50%);
  display: flex; align-items: center; gap: 12px; padding: 12px 22px 12px 14px;
  background: rgba(6,10,12,.82); border: 1px solid rgba(255,179,71,.35); backdrop-filter: blur(8px);
  font-size: 14px; letter-spacing: .6px; animation: promptIn .18s ease both;
}
@keyframes promptIn { from { opacity: 0; transform: translate(-50%, 8px); } }
.key-badge {
  display: inline-flex; align-items: center; justify-content: center; width: 27px; height: 27px;
  border: 1px solid var(--amber); color: var(--amber); font-family: var(--mono); font-size: 13px;
  box-shadow: 0 0 14px rgba(255,179,71,.25), inset 0 0 10px rgba(255,179,71,.1);
}

#relay-panel {
  position: absolute; left: 28px; bottom: 34px; display: flex; gap: 13px; max-width: 540px; align-items: flex-start;
  padding: 14px 20px 14px 14px; background: linear-gradient(100deg, rgba(6,12,14,.86), rgba(6,12,14,.55));
  border-left: 2px solid var(--cyan); backdrop-filter: blur(8px); animation: hudIn .35s ease both;
}
.relay-avatar { position: relative; width: 38px; height: 38px; flex: 0 0 auto; border-radius: 50%; border: 1px solid rgba(95,242,224,.5); background: radial-gradient(circle at 40% 35%, #16343a, #060c0e); box-shadow: 0 0 18px rgba(95,242,224,.25); }
.relay-eye { position: absolute; inset: 11px; border-radius: 50%; background: var(--cyan); box-shadow: 0 0 14px var(--cyan); animation: eyeBlink 3.4s infinite; }
@keyframes eyeBlink { 0%, 92%, 100% { transform: scale(1); opacity: 1; } 95% { transform: scale(.2); opacity: .5; } }
.relay-name { font-family: var(--mono); font-size: 10px; letter-spacing: 2.4px; color: var(--cyan); margin-bottom: 4px; }
.relay-name span { color: rgba(255,255,255,.3); }
#relay-text { font-size: 13.5px; line-height: 1.5; color: #dbe7e8; }

#insight-panel {
  position: absolute; right: 28px; bottom: 34px; width: 320px; padding: 14px 18px;
  background: rgba(10,8,16,.85); border: 1px solid rgba(95,242,224,.4); box-shadow: 0 0 30px rgba(95,242,224,.12);
  animation: hudIn .35s ease both;
}
.insight-title { font-family: var(--mono); font-size: 10px; letter-spacing: 2px; color: var(--cyan); margin-bottom: 5px; }
.insight-body { font-size: 12.5px; color: #cfdcdd; line-height: 1.45; }
#insight-active { position: absolute; right: 28px; bottom: 34px; width: 260px; padding: 12px 16px; background: rgba(10,8,16,.8); border: 1px solid rgba(95,242,224,.35); font-family: var(--mono); font-size: 10px; letter-spacing: 2px; color: var(--cyan); }
.surge-bar { margin-top: 7px; height: 2px; background: rgba(255,255,255,.12); }
.surge-bar i { display: block; height: 100%; width: 100%; background: var(--cyan); box-shadow: 0 0 10px var(--cyan); }

#toast-stack { position: absolute; top: 20%; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; gap: 8px; align-items: center; }
.toast {
  padding: 9px 22px; background: rgba(6,10,12,.82); border-top: 1px solid var(--amber); border-bottom: 1px solid rgba(255,179,71,.2);
  font-family: var(--mono); font-size: 11px; letter-spacing: 2.5px; color: var(--amber-hot);
  animation: toastLife 3.4s ease forwards; backdrop-filter: blur(6px); white-space: nowrap;
}
.toast.cyan { border-top-color: var(--cyan); color: #c8fffa; }
.toast.big { font-size: 14px; padding: 12px 30px; }
@keyframes toastLife { 0% { opacity: 0; transform: translateY(-8px); } 8%, 78% { opacity: 1; transform: translateY(0); } 100% { opacity: 0; transform: translateY(-6px); } }

#objective-marker { position: absolute; left: 0; top: 0; transform: translate(-50%, -100%); text-align: center; opacity: .95; }
.marker-diamond { width: 12px; height: 12px; margin: 0 auto 5px; border: 1px solid var(--amber); transform: rotate(45deg); box-shadow: 0 0 12px rgba(255,179,71,.5); animation: markerPulse 1.6s infinite; }
@keyframes markerPulse { 50% { transform: rotate(45deg) scale(1.25); box-shadow: 0 0 20px rgba(255,179,71,.8); } }
#marker-label { font-family: var(--mono); font-size: 9px; letter-spacing: 2px; color: var(--amber); white-space: nowrap; text-shadow: 0 1px 6px #000; }

@keyframes hudIn { from { opacity: 0; transform: translateY(-6px); } }

/* ================= SCREENS ================= */
.screen { position: fixed; inset: 0; z-index: 30; display: flex; align-items: center; justify-content: center; }
#menu { background: radial-gradient(ellipse at 62% 42%, rgba(38,20,8,.45), transparent 55%), linear-gradient(120deg, rgba(4,7,9,.9) 20%, rgba(6,10,13,.72) 100%); overflow: hidden; backdrop-filter: blur(2px); }
.menu-bg-glow { position: absolute; width: 900px; height: 900px; right: -160px; top: 50%; transform: translateY(-50%); background: radial-gradient(circle, rgba(255,140,40,.18), transparent 62%); filter: blur(20px); animation: breathe 9s ease-in-out infinite; }
@keyframes breathe { 50% { opacity: .55; transform: translateY(-50%) scale(1.12); } }
.menu-grid {
  position: absolute; inset: -10%; opacity: .13;
  background-image: linear-gradient(rgba(255,179,71,.5) 1px, transparent 1px), linear-gradient(90deg, rgba(255,179,71,.5) 1px, transparent 1px);
  background-size: 78px 78px; transform: perspective(600px) rotateX(58deg) translateY(30%);
  mask-image: linear-gradient(to top, black, transparent 70%);
}
.menu-inner { position: relative; z-index: 2; text-align: left; padding-left: 9vw; max-width: 760px; }
.brand-line { display: flex; align-items: center; gap: 12px; font-family: var(--mono); font-size: 10px; letter-spacing: 5px; color: var(--amber); opacity: .9; }
.brand-line span { display: block; height: 1px; width: 40px; background: rgba(255,179,71,.45); }
.game-title {
  font-size: clamp(64px, 9.2vw, 132px); line-height: .9; font-weight: 800; letter-spacing: -4px; margin: 12px 0 4px;
  background: linear-gradient(180deg, #fff 10%, #ffd9a1 45%, #b06f27 100%);
  -webkit-background-clip: text; background-clip: text; color: transparent;
  filter: drop-shadow(0 12px 40px rgba(255,140,40,.28));
}
.game-title .colon { color: var(--amber); -webkit-text-fill-color: var(--amber); opacity: .9; }
.game-subtitle { font-family: var(--mono); letter-spacing: 9px; font-size: clamp(11px, 1.3vw, 15px); color: #b9c7c9; padding-left: 3px; }
.menu-copy { margin: 30px 0 34px; font-size: 16px; line-height: 1.7; color: #93a4a7; max-width: 430px; }
.menu-buttons { display: flex; flex-direction: column; gap: 9px; width: 300px; }
.menu-footer { display: flex; flex-wrap: wrap; gap: 18px; margin-top: 42px; font-family: var(--mono); font-size: 9px; letter-spacing: 2px; color: rgba(255,255,255,.28); }
.menu-credit { position: absolute; bottom: 22px; left: 9vw; font-family: var(--mono); font-size: 9px; letter-spacing: 2px; color: rgba(255,255,255,.2); }

.btn {
  --b: rgba(255,255,255,.16);
  position: relative; padding: 13px 22px; text-align: left; font-family: var(--mono); font-size: 12px; letter-spacing: 3.5px;
  color: #dbe6e7; background: rgba(255,255,255,.035); border: 1px solid var(--b); cursor: pointer;
  transition: all .22s ease; backdrop-filter: blur(6px);
}
.btn:hover { color: #fff; border-color: rgba(255,179,71,.6); background: rgba(255,179,71,.09); padding-left: 28px; }
.btn:active { transform: translateY(1px); }
.btn.primary { background: linear-gradient(90deg, rgba(255,179,71,.22), rgba(255,179,71,.05)); border-color: rgba(255,179,71,.55); color: #ffe6c2; box-shadow: inset 0 0 30px rgba(255,179,71,.08); }
.btn.primary:hover { background: linear-gradient(90deg, rgba(255,179,71,.35), rgba(255,179,71,.1)); box-shadow: 0 0 30px rgba(255,179,71,.15); }
.btn.danger:hover { border-color: rgba(255,90,90,.6); background: rgba(255,90,90,.08); }
.btn:disabled { opacity: .32; cursor: default; padding-left: 22px; }
.btn.ghost { font-size: 10.5px; letter-spacing: 2.5px; }
.btn.primary::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--amber); box-shadow: 0 0 14px var(--amber); }

.modal-screen { background: rgba(3,5,7,.68); backdrop-filter: blur(10px); z-index: 35; }
.modal {
  width: 420px; max-width: 92vw; padding: 30px 34px; background: linear-gradient(160deg, rgba(16,22,25,.97), rgba(7,11,13,.97));
  border: 1px solid rgba(255,255,255,.09); border-top: 1px solid rgba(255,179,71,.5);
  box-shadow: 0 30px 80px rgba(0,0,0,.6); animation: modalIn .28s cubic-bezier(.2,.8,.2,1) both;
}
@keyframes modalIn { from { opacity: 0; transform: translateY(14px) scale(.98); } }
.modal h2 { font-size: 26px; letter-spacing: 4px; font-weight: 700; margin-bottom: 20px; }
.pause-kicker, .mc-kicker, .ending-kicker { font-family: var(--mono); font-size: 10px; letter-spacing: 4px; color: var(--amber); margin-bottom: 4px; }
.pause-modal { width: 380px; text-align: center; }
.pause-modal .modal-buttons { margin-top: 22px; }
.pause-stats { display: flex; justify-content: center; gap: 20px; font-family: var(--mono); font-size: 10px; letter-spacing: 1.5px; color: var(--dim); margin-bottom: 6px; }
.pause-hint { margin-top: 18px; font-size: 10px; color: rgba(255,255,255,.28); line-height: 1.5; }
.modal-buttons { display: flex; gap: 10px; margin-top: 26px; }
.modal-buttons.column { flex-direction: column; }
.modal-buttons .btn { flex: 1; text-align: center; }
.modal-buttons .btn:hover { padding-left: 22px; }

.setting-row { display: grid; grid-template-columns: 1fr 150px 46px; align-items: center; gap: 12px; padding: 11px 0; border-bottom: 1px solid rgba(255,255,255,.06); }
.setting-row label { font-size: 13px; color: #c3d0d2; }
.setting-val { font-family: var(--mono); font-size: 11px; color: var(--amber); text-align: right; }
input[type=range] { -webkit-appearance: none; appearance: none; height: 2px; background: rgba(255,255,255,.18); outline: none; }
input[type=range]::-webkit-slider-thumb { -webkit-appearance: none; width: 12px; height: 12px; background: var(--amber); border-radius: 50%; box-shadow: 0 0 10px rgba(255,179,71,.6); cursor: pointer; }
input[type=checkbox] { width: 16px; height: 16px; accent-color: var(--amber); justify-self: start; }
select { background: #101619; color: #dfe9ea; border: 1px solid rgba(255,255,255,.14); padding: 7px 8px; font-family: var(--mono); font-size: 11px; }
#controls-list { margin-top: 14px; }
.control-row { display: flex; justify-content: space-between; padding: 7px 0; font-size: 12.5px; color: #b8c5c7; border-bottom: 1px solid rgba(255,255,255,.05); }
.control-row b { font-family: var(--mono); font-size: 10.5px; letter-spacing: 2px; color: var(--amber); }

.mission-complete-card {
  text-align: center; padding: 46px 60px; max-width: 600px;
  background: radial-gradient(ellipse at 50% 0%, rgba(255,179,71,.12), transparent 60%), rgba(5,9,11,.9);
  border-top: 1px solid rgba(255,179,71,.5); border-bottom: 1px solid rgba(255,179,71,.12);
  animation: modalIn .4s ease both;
}
.mission-complete-card h2 { font-size: clamp(28px, 4vw, 44px); letter-spacing: 1px; margin: 10px 0 14px; }
.mission-complete-card p { color: #9fb0b3; font-size: 14px; line-height: 1.7; max-width: 420px; margin: 0 auto; }
.mc-line { height: 1px; width: 70px; background: var(--amber); margin: 24px auto; opacity: .6; }
.mission-complete-card .btn { display: inline-block; padding: 13px 40px; text-align: center; }
.mission-complete-card .btn::before { display: none; }

#ending { background: radial-gradient(ellipse at 50% 30%, rgba(255,190,100,.14), transparent 60%), #05090b; z-index: 45; }
.ending-inner { text-align: center; max-width: 720px; padding: 30px; }
.ending-title { font-size: clamp(56px, 10vw, 130px); font-weight: 800; letter-spacing: -3px; line-height: .95; margin: 18px 0 22px;
  background: linear-gradient(180deg, #fff, #ffd8a0 55%, #b9792c); -webkit-background-clip: text; background-clip: text; color: transparent; }
.ending-title span { display: block; }
.ending-copy { color: #a9babc; font-size: 15px; line-height: 1.8; max-width: 440px; margin: 0 auto 26px; }
.ending-stats { display: flex; justify-content: center; gap: 40px; font-family: var(--mono); font-size: 11px; letter-spacing: 2px; color: #c9d6d8; padding: 18px 0; border-top: 1px solid rgba(255,255,255,.08); border-bottom: 1px solid rgba(255,255,255,.08); }
.ending-stats b { display: block; font-size: 22px; color: var(--amber); margin-bottom: 5px; letter-spacing: 1px; }
#ending .modal-buttons { justify-content: center; margin-top: 26px; }
#ending .btn { flex: 0 0 auto; padding: 13px 34px; }

#loading { background: #04070a; z-index: 70; }
.loading-inner { text-align: center; width: 420px; }
.loading-logo { font-size: 42px; font-weight: 800; letter-spacing: 2px; color: #f3e6d4; }
.loading-logo span { color: var(--amber); }
.loading-bar { margin: 22px 0 12px; height: 2px; background: rgba(255,255,255,.1); overflow: hidden; }
.loading-bar i { display: block; height: 100%; width: 0%; background: var(--amber); box-shadow: 0 0 16px var(--amber); transition: width .35s ease; }
#loading-text { font-family: var(--mono); font-size: 9.5px; letter-spacing: 3px; color: var(--dim); }
.loading-tip { margin-top: 34px; font-size: 11.5px; line-height: 1.6; color: rgba(255,255,255,.3); }

@media (max-width: 760px) {
  #mission-panel { min-width: 220px; max-width: 260px; top: 14px; left: 14px; padding: 12px 14px; }
  #stats-panel { top: 14px; right: 14px; }
  #compass { display: none; }
  .menu-inner { padding-left: 6vw; }
  #relay-panel { left: 14px; right: 14px; bottom: 14px; max-width: none; }
  #insight-panel { right: 14px; bottom: 130px; width: auto; left: 14px; }
  .menu-footer { display: none; }
}
